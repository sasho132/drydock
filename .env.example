# Copy to .env and adjust. Never commit .env; it is git-ignored.

# ---------------------------------------------------------------------------
# Docker socket access
# ---------------------------------------------------------------------------
# The container runs as nonroot and needs the group that owns the socket.
#   Linux:          stat -c '%g' /var/run/docker.sock
#   Docker Desktop: 0
# Rootless Docker:  stat -c '%g' "$XDG_RUNTIME_DIR/docker.sock"
DOCKER_GID=0

# ---------------------------------------------------------------------------
# Image
# ---------------------------------------------------------------------------
# Empty/unset = build locally with `docker compose up -d --build`.
# Set to a published image to pull instead of building.
# DRYDOCK_IMAGE=ghcr.io/sasho132/drydock:latest

# ---------------------------------------------------------------------------
# Dashboard and JSON API
# ---------------------------------------------------------------------------
DRYDOCK_API_ENABLED=true
DRYDOCK_UI_ENABLED=true
DRYDOCK_UI_USERNAME=admin
# Set a strong password to enable update/rollback actions.
# Empty = read-only dashboard.
DRYDOCK_UI_PASSWORD=
# Bearer token for mutating /v1 endpoints. Optional.
# DRYDOCK_API_TOKEN=change-me-too
# 127.0.0.1 is safe: reach it via an SSH tunnel or a TLS reverse proxy.
# Set 0.0.0.0 to expose it on your LAN.
DRYDOCK_BIND=127.0.0.1
DRYDOCK_PORT=8080

# ---------------------------------------------------------------------------
# Schedule and update policy
# ---------------------------------------------------------------------------
DRYDOCK_INTERVAL=6h
# Cron expression instead of the interval, e.g. "0 4 * * *" or "@every 6h".
# DRYDOCK_SCHEDULE="0 4 * * *"
# DRYDOCK_SCOPE=
DRYDOCK_CONCURRENCY=2
DRYDOCK_KEEP_IMAGES=2
DRYDOCK_ROLLBACK=true
DRYDOCK_CLEANUP=false
DRYDOCK_REMOVE_VOLUMES=false
DRYDOCK_MONITOR_ONLY=false
DRYDOCK_INCLUDE_STOPPED=false
DRYDOCK_LABEL_ENABLE=false
DRYDOCK_DRY_RUN=false

# ---------------------------------------------------------------------------
# Timeouts and logging
# ---------------------------------------------------------------------------
DRYDOCK_STOP_TIMEOUT=30s
DRYDOCK_HEALTH_TIMEOUT=2m
DRYDOCK_SETTLE=3s
DRYDOCK_LOG_LEVEL=info
DRYDOCK_LOG_FORMAT=text

# ---------------------------------------------------------------------------
# Private registries
# ---------------------------------------------------------------------------
# Only needed for private images. Used by drydock.yaml as ${DOCKERHUB_TOKEN};
# create a read-only Docker Hub personal access token.
# DOCKERHUB_TOKEN=dckr_pat_...

# Only for private registries with self-signed certificates.
DRYDOCK_REGISTRY_INSECURE_SKIP_VERIFY=false
