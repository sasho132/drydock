# Copy to .env, then fill in the values. Never commit .env.

# Group that owns /var/run/docker.sock.
#   Linux:          stat -c '%g' /var/run/docker.sock
#   Docker Desktop: 0
DOCKER_GID=0

# Dashboard and API
DRYDOCK_API_ENABLED=true
DRYDOCK_UI_USERNAME=admin
# Empty = read-only dashboard (no update/rollback buttons).
DRYDOCK_UI_PASSWORD=change-me
# 127.0.0.1 is safe (use an SSH tunnel or a reverse proxy).
# Set 0.0.0.0 to expose it on your LAN.
DRYDOCK_BIND=127.0.0.1
DRYDOCK_PORT=8080

# Update policy
DRYDOCK_INTERVAL=6h
DRYDOCK_ROLLBACK=true
DRYDOCK_CLEANUP=false
DRYDOCK_CONCURRENCY=2
DRYDOCK_LOG_LEVEL=info

# Optional: use a prebuilt image instead of building on the server.
# Requires a published v* tag and either a public package or `docker login ghcr.io`.
# DRYDOCK_IMAGE=ghcr.io/yourname/drydock:latest

# Optional: protect the JSON API with a bearer token.
# DRYDOCK_API_TOKEN=change-me-too
